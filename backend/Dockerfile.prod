# Production image for the FastAPI API (Cloud Run).
# Dev uses ./Dockerfile (uvicorn --reload, bind-mounted source); this image is
# self-contained and serves on $PORT (Cloud Run injects PORT=8080).
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

# Install deps first so this layer caches unless requirements change.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# App source (no bind mount in prod).
COPY . .

EXPOSE 8080

# No --reload. `exec` so uvicorn is PID 1 and receives Cloud Run's SIGTERM.
# Shell form so ${PORT} expands (Cloud Run may override it).
CMD exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT}
