# Production image for the Vite React app (Cloud Run).
# Two stages: build the static bundle with Node, then serve it with nginx, which
# also reverse-proxies /api to the backend so the browser uses a single origin
# (first-party session cookie). Vite bakes VITE_* into the bundle AT BUILD TIME;
# VITE_API_URL is left EMPTY so the client calls /api on its own origin.
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# These reach the browser bundle — not secrets. Undefined → empty string, and
# the client falls back to its localhost default (see src/lib/api.ts).
ARG VITE_API_URL
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_API_URL=$VITE_API_URL \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build

# ── Runtime: nginx serves the SPA + reverse-proxies /api to the backend ──
FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
# The nginx image's entrypoint runs envsubst on templates at container start,
# filling ${PORT} and ${BACKEND_ORIGIN} from env (Cloud Run injects both).
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

ENV PORT=8080
EXPOSE 8080
