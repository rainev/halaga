# Copy to .env and fill in. docker-compose reads this file automatically.
# Missing a required value makes the backend fail fast at startup (see app/env.py).

# --- Postgres ---
POSTGRES_USER=valuation
POSTGRES_PASSWORD=valuation_dev_pw
POSTGRES_DB=valuation

# --- Object storage (MinIO in dev) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=valuation

# --- Auth / JWT (generate strong random values for anything real) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7

# --- Seed admin (created/updated by infrastructure/scripts/seed.sh) ---
# Note: use a real TLD — .local is rejected by email validation.
ADMIN_EMAIL=admin@valuation.app
ADMIN_PASSWORD=admin12345
