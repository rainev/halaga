# Copy to .env and fill in. docker-compose reads this file automatically.
# Missing a required value makes the backend fail fast at startup (see app/env.py).

# --- Postgres ---
POSTGRES_USER=valuation
POSTGRES_PASSWORD=valuation_dev_pw
POSTGRES_DB=valuation

# --- Object storage (MinIO in dev) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=valuation

# --- Auth / JWT (generate strong random values for anything real) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7

# --- Seed admin (created/updated by infrastructure/scripts/seed.sh) ---
# Note: use a real TLD — .local is rejected by email validation.
ADMIN_EMAIL=admin@valuation.app
ADMIN_PASSWORD=admin12345

# --- Google sign-in (optional) ---
# One OAuth 2.0 Web client id, shared by backend (verify) and frontend (button).
# https://console.cloud.google.com/apis/credentials — Authorized JS origin
# http://localhost:4000. Blank disables Google auth.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Rate limiting ---
# Postgres-backed, per-IP/user. Auto-disabled under tests. Set false to turn off.
RATE_LIMIT_ENABLED=true

# --- OpenAI + insights pipeline (see docs/architecture.md) ---
# Blank OPENAI_API_KEY = LLM steps skipped; ticker/sector matching still runs.
OPENAI_API_KEY=
OPENAI_INSIGHT_MODEL=gpt-4o
OPENAI_EXTRACT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Min confidence to generate an insight for an (article, company) link.
INSIGHT_CONFIDENCE_THRESHOLD=0.5
# false = run pipeline manually; true = auto-process on admin article submit.
PIPELINE_AUTO=false

# --- Supabase / managed Postgres (staging) ---
# We own auth; Supabase is used only as Postgres. Point the app at the Session
# pooler (Dashboard -> Connect -> Session pooler). The pooled user is
# postgres.<project-ref>. Set PGSSL=true for any managed provider.
# SUPABASE_URL=https://<project-ref>.supabase.co
# PGHOST=aws-0-<region>.pooler.supabase.com
# PGPORT=5432
# PGUSER=postgres.<project-ref>
# PGPASSWORD=<database-password>
# PGDATABASE=postgres
# PGSSL=true
